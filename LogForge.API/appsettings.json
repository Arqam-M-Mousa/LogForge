{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logforge;Username=postgres;Password=postgres;Maximum Pool Size=15;Timeout=20;Command Timeout=20"
  },
  "Ingestion": {
    "MaxBatchSize": 2000,
    "FlushIntervalMs": 25
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/",
    "QueueName": "logforge.ingestion",
    "PublisherCount": 2,
    "ConsumerCount": 2,
    "ConsumerBatchSize": 60,
    "ConsumerBatchFlushIntervalMs": 15,
    "ConsumerPrefetchCount": 60
  },
  "AggregationCache": {
    "TtlSeconds": 5,
    "MaxEntries": 256,
    "QueryTimeoutSeconds": 8
  },
  "Retention": {
    "RetentionDays": 30,
    "RunAtUtc": "02:00:00",
    "DeleteBatchSize": 10000
  },
  "AllowedHosts": "*"
}