{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logforge;Username=postgres;Password=postgres;"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/",
    "QueueName": "logforge.ingestion",
    "ConsumerBatchSize": 100,
    "ConsumerBatchWaitMs": 20,
    "PrefetchCount": 100
  },
  "AggregationCache": {
    "TtlSeconds": 5,
    "MaxEntries": 256,
    "QueryTimeoutSeconds": 8
  },
  "Retention": {
    "RetentionDays": 30,
    "RunAtUtc": "02:00:00",
    "DeleteBatchSize": 10000
  },
  "AllowedHosts": "*"
}