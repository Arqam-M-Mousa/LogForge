{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logforge;Username=postgres;Password=postgres;Maximum Pool Size=50;Timeout=20;Command Timeout=20"
  },
  "Ingestion": {
    "ChannelCapacity": 128,
    "MaxBatchSize": 2000,
    "FlushIntervalMs": 25
  },
  "AggregationCache": {
    "TtlSeconds": 5,
    "MaxEntries": 256,
    "QueryTimeoutSeconds": 8
  },
  "AllowedHosts": "*"
}